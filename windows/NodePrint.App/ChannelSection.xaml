<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NodePrint.App.ChannelSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Width="480" Height="84">
        <!-- Section header: positioned by cap height, title and detail share a baseline. -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="6,0,0,0">
            <TextBlock
                x:Name="TitleText"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{StaticResource InkBrush}"
                TextLineBounds="Tight"
                VerticalAlignment="Bottom" />
            <TextBlock
                x:Name="DetailText"
                Margin="9.5,0,0,0"
                FontSize="12"
                Foreground="{StaticResource SecondaryInkBrush}"
                TextLineBounds="Tight"
                VerticalAlignment="Bottom" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,6,0">
            <Ellipse x:Name="StateDot" Width="6" Height="6" Margin="0,3.5,6,0" VerticalAlignment="Top" />
            <TextBlock
                x:Name="StateText"
                Margin="0,1.5,0,0"
                FontSize="12"
                FontWeight="Medium"
                TextLineBounds="Tight"
                VerticalAlignment="Top" />
        </StackPanel>

        <Button
            x:Name="Card"
            Style="{StaticResource CardButtonStyle}"
            Height="60"
            Margin="0,24,0,0"
            VerticalAlignment="Top"
            Click="OnCardClick">
            <FlyoutBase.AttachedFlyout>
                <!-- Under the card, as wide as it, inside the window: a long list scrolls and a card low in the window
                     opens it upwards. The presenter keeps its own Acrylic background, corners and shadow. -->
                <Flyout
                    x:Name="Picker"
                    Placement="Bottom"
                    ShouldConstrainToRootBounds="True"
                    Opened="OnPickerOpened"
                    Closed="OnPickerClosed">
                    <Flyout.FlyoutPresenterStyle>
                        <Style TargetType="FlyoutPresenter">
                            <Setter Property="MinWidth" Value="480" />
                            <Setter Property="MaxWidth" Value="480" />
                            <Setter Property="MaxHeight" Value="214" />
                            <Setter Property="Padding" Value="6" />
                        </Style>
                    </Flyout.FlyoutPresenterStyle>
                    <StackPanel>
                        <TextBlock
                            x:Name="NoPrintersText"
                            Margin="10,8,10,8"
                            FontSize="13"
                            Foreground="{StaticResource SecondaryInkBrush}"
                            Visibility="Collapsed" />
                        <StackPanel x:Name="PickerList" Spacing="2" />
                    </StackPanel>
                </Flyout>
            </FlyoutBase.AttachedFlyout>
            <Grid>
                <Grid Width="38" Height="38" Margin="11,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Canvas x:Name="TileShadow" />
                    <Rectangle
                        x:Name="TileShape"
                        Fill="White"
                        Stroke="{StaticResource TileBorderBrush}"
                        StrokeThickness="1"
                        RadiusX="11"
                        RadiusY="11" />
                    <FontIcon
                        x:Name="TileIcon"
                        FontFamily="{StaticResource IconFont}"
                        FontSize="16"
                        Foreground="{StaticResource InkBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Grid>
                <Ellipse Width="12" Height="12" Margin="38.75,38.75,0,0" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Top" />
                <Ellipse x:Name="TileDot" Width="8" Height="8" Margin="40.75,40.75,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />

                <StackPanel Margin="60,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="NameText"
                        FontSize="14"
                        FontWeight="Medium"
                        Foreground="{StaticResource InkBrush}"
                        TextLineBounds="Tight"
                        TextTrimming="CharacterEllipsis"
                        MaxWidth="330" />
                    <TextBlock
                        x:Name="SubtitleText"
                        Margin="0,6.7,0,0"
                        FontSize="11.5"
                        Foreground="{StaticResource SecondaryInkBrush}"
                        TextLineBounds="Tight" />
                </StackPanel>

                <Border
                    x:Name="ConnectionPill"
                    Height="24"
                    Margin="0,0,43.5,0"
                    Padding="5,0,5,0"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{StaticResource PillBorderBrush}"
                    Background="White"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                    <TextBlock
                        x:Name="ConnectionText"
                        FontSize="10"
                        FontWeight="Medium"
                        Foreground="{StaticResource PillInkBrush}"
                        TextLineBounds="Tight"
                        VerticalAlignment="Center" />
                </Border>

                <FontIcon
                    Glyph="&#xE70D;"
                    FontFamily="{StaticResource IconFont}"
                    FontSize="14"
                    Foreground="{StaticResource SecondaryInkBrush}"
                    Width="20"
                    Margin="0,0,12,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
                    <FontIcon.RenderTransform>
                        <RotateTransform x:Name="ChevronTurn" />
                    </FontIcon.RenderTransform>
                </FontIcon>
            </Grid>
        </Button>
    </Grid>
</UserControl>
