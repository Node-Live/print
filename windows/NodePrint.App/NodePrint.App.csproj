<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>NodePrint.App</RootNamespace>
    <AssemblyName>NodePrint</AssemblyName>
    <AssemblyTitle>NODE Print</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\NodePrint.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultLanguage>en-US</DefaultLanguage>
    <SatelliteResourceLanguages>en-US;zh-CN;es-ES</SatelliteResourceLanguages>
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- The components of Windows App SDK 2.5.1 the app uses; the full package would also carry its AI, ML, search and
         widgets parts (onnxruntime, DirectML …). -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.366" PrivateAssets="all" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NodePrint.Core\NodePrint.Core.csproj" />
    <ProjectReference Include="..\NodePrint.Printing\NodePrint.Printing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\NodePrint.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The installer carries only what runs: no symbols; none of the files packages drop in for features the app does
       not use (WebView2, the IIS module of ASP.NET Core, background tasks, push notifications, packaged deployment,
       restart, the XAML designer, phone controls, map assets, WinRT metadata); and of the runtime's translations only
       the app's own three languages. -->
  <PropertyGroup>
    <UnusedPublishFiles>;Microsoft.Web.WebView2.Core.dll;WebView2Loader.dll;aspnetcorev2_inprocess.dll;Microsoft.Windows.ApplicationModel.Background.UniversalBGTask.dll;PushNotificationsLongRunningTask.ProxyStub.dll;DeploymentAgent.exe;RestartAgent.exe;Microsoft.UI.Designer.dll;Microsoft.UI.Xaml.Phone.dll;map.html;</UnusedPublishFiles>
    <KeptLanguages>;en-US;zh-CN;es-ES;</KeptLanguages>
  </PropertyGroup>
  <Target Name="LeaveUnusedOutOfPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb' or '%(Extension)' == '.winmd'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$(UnusedPublishFiles.Contains(';%(Filename)%(Extension);'))" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(Extension)' == '.mui' and !$(KeptLanguages.Contains(';$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName(%(RelativePath)))));'))" />
    </ItemGroup>
  </Target>
</Project>
